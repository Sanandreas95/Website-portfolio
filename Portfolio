@app.route("/api/forecast")
def api_forecast():
    """JSON endpoint that backs the weather page."""
    city = (request.args.get("city") or "").strip()
    if not city:
        return jsonify({"error": "Missing ?city= parameter"}), 400
    try:
        return jsonify(get_full_forecast(city))
    except ValueError as e:
        return jsonify({"error": str(e)}), 404
    except Exception as e:
        log.error("Forecast failed for %r: %s\n%s", city, e, traceback.format_exc())
        return jsonify({"error": "Forecast service is temporarily unavailable."}), 502


