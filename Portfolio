<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
const WMO = {
    0:{txt:"Clear sky",icon:"☀️"}, 1:{txt:"Mainly clear",icon:"🌤️"},
    2:{txt:"Partly cloudy",icon:"⛅"}, 3:{txt:"Overcast",icon:"☁️"},
    45:{txt:"Fog",icon:"🌫️"}, 48:{txt:"Rime fog",icon:"🌫️"},
    51:{txt:"Light drizzle",icon:"🌦️"}, 53:{txt:"Drizzle",icon:"🌦️"},
    55:{txt:"Heavy drizzle",icon:"🌧️"},
    61:{txt:"Light rain",icon:"🌦️"}, 63:{txt:"Rain",icon:"🌧️"},
    65:{txt:"Heavy rain",icon:"🌧️"},
    71:{txt:"Light snow",icon:"🌨️"}, 73:{txt:"Snow",icon:"❄️"},
    75:{txt:"Heavy snow",icon:"❄️"},
    80:{txt:"Showers",icon:"🌦️"}, 81:{txt:"Heavy showers",icon:"🌧️"},
    82:{txt:"Violent showers",icon:"⛈️"},
    95:{txt:"Thunderstorm",icon:"⛈️"}, 96:{txt:"Storm w/ hail",icon:"⛈️"},
    99:{txt:"Severe storm",icon:"⛈️"},
};
const wmo = (c) => WMO[c] || { txt: "—", icon: "•" };
let chartInstance = null;

function setStatus(msg, isError) {
    const el = document.getElementById("status");
    el.textContent = msg || "";
    el.classList.toggle("error", !!isError);
}
function fmtTime(iso) {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso;
    return d.toLocaleString([], { weekday: "short", hour: "numeric" });
}
async function fetchForecast(city) {
    const r = await fetch(`/api/forecast?city=${encodeURIComponent(city)}`);
    const b = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(b.error || `HTTP ${r.status}`);
    return b;
}

function renderCurrent(data) {
    const loc = data.location || {}, cur = data.current || {};
    document.getElementById("cur-temp").textContent =
        cur.temperature_2m != null ? Math.round(cur.temperature_2m) : "--";
    document.getElementById("cur-location").textContent =
        [loc.name, loc.admin1, loc.country].filter(Boolean).join(", ");
    const w = wmo(cur.weather_code);
    document.getElementById("cur-condition").textContent = `${w.icon}  ${w.txt}`;
    document.getElementById("cur-humidity").textContent =
        cur.relative_humidity_2m != null ? `${cur.relative_humidity_2m}%` : "—";
    document.getElementById("cur-wind").textContent =
        cur.wind_speed_10m != null ? `${cur.wind_speed_10m} km/h` : "—";
    document.getElementById("cur-precip").textContent =
        cur.precipitation != null ? `${cur.precipitation} mm` : "—";
    document.getElementById("ml-status").textContent =
        data.ml_available ? "Active" : "Not trained";
}
function renderDaily(data) {
    const d = data.daily || {};
    const strip = document.getElementById("daily-strip");
    strip.innerHTML = "";
    (d.time || []).forEach((t, i) => {
        const date = new Date(t);
        const dow = date.toLocaleDateString([], { weekday: "short" });
        const hi = Math.round(d.temperature_2m_max?.[i]);
        const lo = Math.round(d.temperature_2m_min?.[i]);
        const w = wmo(d.weather_code?.[i]);
        const p = d.precipitation_sum?.[i] ?? 0;
        const card = document.createElement("div");
        card.className = "day";
        card.innerHTML =
            `<div class="dow">${dow}</div>` +
            `<div class="icon" title="${w.txt}">${w.icon}</div>` +
            `<div><span class="hi">${hi}°</span> / <span class="lo">${lo}°</span></div>` +
            `<div class="dow">${p} mm</div>`;
        strip.appendChild(card);
    });
}
function renderChart(data) {
    const hourly = data.hourly || {};
    const refinement = data.ml_refinement || [];
    const times = (hourly.time || []).slice(0, 24);
    const nwp = (hourly.temperature_2m || []).slice(0, 24);
    const refByTime = new Map(refinement.map(r => [r.time, r]));
    const ml = times.map(t => refByTime.get(t)?.ml_temperature_c ?? null);
    const blended = times.map(t => refByTime.get(t)?.blended_temperature_c ?? null);

    const ctx = document.getElementById("hourly-chart").getContext("2d");
    if (chartInstance) chartInstance.destroy();
    chartInstance = new Chart(ctx, {
        type: "line",
        data: { labels: times.map(fmtTime), datasets: [
            { label: "NWP forecast (°C)", data: nwp,
              borderColor: "#0b2545", backgroundColor: "rgba(11,37,69,0.10)",
              fill: true, tension: 0.35, borderWidth: 2, pointRadius: 0 },
            { label: "ML refinement (°C)", data: ml,
              borderColor: "#ffb703", borderDash: [6, 4],
              tension: 0.35, borderWidth: 2, pointRadius: 0, spanGaps: true },
            { label: "Blended ensemble (°C)", data: blended,
              borderColor: "#7e57c2", borderDash: [2, 3],
              tension: 0.35, borderWidth: 2, pointRadius: 0, spanGaps: true },
        ]},
        options: {
            responsive: true, maintainAspectRatio: false,
            interaction: { mode: "index", intersect: false },
            plugins: { legend: { labels: { color: "#222" } } },
            scales: {
                x: { ticks: { color: "#666" }, grid: { color: "rgba(0,0,0,0.06)" } },
                y: { ticks: { color: "#666" }, grid: { color: "rgba(0,0,0,0.06)" } },
            },
        },
    });
}
function renderTable(data) {
    const h = data.hourly || {};
    const tbody = document.querySelector("#hourly-table tbody");
    tbody.innerHTML = "";
    const n = Math.min(48, (h.time || []).length);
    for (let i = 0; i < n; i++) {
        const tr = document.createElement("tr");
        tr.innerHTML =
            `<td>${fmtTime(h.time[i])}</td>` +
            `<td>${Math.round(h.temperature_2m?.[i])}°</td>` +
            `<td>${(h.precipitation?.[i] ?? 0).toFixed(1)} mm</td>` +
            `<td>${Math.round(h.wind_speed_10m?.[i] ?? 0)} km/h</td>` +
            `<td>${h.relative_humidity_2m?.[i] ?? "—"}%</td>`;
        tbody.appendChild(tr);
    }
}
async function handleSubmit(e) {
    e.preventDefault();
    const city = document.getElementById("city-input").value.trim();
    if (!city) return;
    setStatus("Loading…");
    document.getElementById("results").hidden = true;
    try {
        const data = await fetchForecast(city);
        renderCurrent(data); renderDaily(data); renderChart(data); renderTable(data);
        document.getElementById("results").hidden = false;
        setStatus("");
    } catch (err) {
        setStatus(`Couldn't load forecast: ${err.message}`, true);
    }
}
document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("search-form").addEventListener("submit", handleSubmit);
});
</script>
